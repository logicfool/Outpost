{
  "name": "outpost-valorant-companion",
  "version": "0.7.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/patch-native-deps.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/test-core.cjs",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.cjs",
    "doctor": "npx expo-doctor",
    "preview": "node scripts/preview-server.mjs",
    "test:ui": "expo export --platform web --max-workers 1 --output-dir dist-web && node scripts/test-ui.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-cookies/cookies": "^6.2.1",
    "buffer": "6.0.3",
    "expo": "~57.0.0",
    "expo-background-task": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.17",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-tcp-socket": "6.4.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "saxes": "6.0.0",
    "string_decoder": "1.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "playwright": "1.63.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
