{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "unsigned": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "ios": {
        "simulator": true
      }
    },
    "unsigned-ipa": {
      "distribution": "internal",
      "ios": {
        "withoutCredentials": true,
        "config": "unsigned-ios.yml"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "login-smoke": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "config": "login-smoke.yml",
        "image": "latest"
      }
    },
    "release-smoke": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "config": "release-smoke.yml",
        "image": "latest"
      }
    }
  }
}
